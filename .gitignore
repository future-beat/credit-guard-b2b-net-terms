node_modules

# macOS
.DS_Store

/.cache
/build
/app/build
/public/build/
/public/_dev
/app/public/build
/prisma/dev.sqlite
/prisma/dev.sqlite-journal
database.sqlite

.env
.env.*
# ...but the env contract itself is committed (names only, never values)
!.env.example

# The upstream template ignores lockfiles because it is a template.
# This is a real app: the lockfile is committed so Railway builds are
# reproducible and the package-legitimacy audit stays cross-checkable.
yarn.lock
pnpm-lock.yaml

/extensions/*/dist

# Ignore shopify files created during app dev
.shopify/*
.shopify.lock

# Hide files auto-generated by react router
.react-router/

# GraphQL codegen output (`npm run graphql-codegen`): ~10MB of regenerable
# artifacts, of which 6.7MB is the pinned Admin 2026-07 schema dump. The GATE is
# running codegen — it validates every `#graphql` document against the schema and
# fails the build on a bad field — not storing its output. Regenerate any time.
/app/types/

# GSD planning cache
.planning/**/.cache/
.claude/worktrees/

Screencast.mov

# Listing source art (large originals kept locally, not in git)
listing/icon/*-original.png


# Vercel link for the static site (site/), never committed
site/.vercel/
