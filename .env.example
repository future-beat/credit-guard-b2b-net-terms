# Environment contract for Credit Guard: B2B Net Terms.
# Copy to .env for local development. Names only here — never commit real values.

# Postgres connection string.
# Local dev:  postgresql://<role>@localhost:5432/creditguard_dev
# Local test: postgresql://<role>@localhost:5432/creditguard_test
# Railway:    supplied by the attached Postgres service reference variable
DATABASE_URL=

# Shopify app credentials. Populated by `shopify app dev` / `shopify app config link`
# locally; set explicitly as Railway service variables in production.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=

# Optional under managed installation.
SCOPES=

# Error tracking (D-03) — wired in plan 01-02.
SENTRY_DSN=

# Set by the host in production; do not hardcode a port.
NODE_ENV=
PORT=